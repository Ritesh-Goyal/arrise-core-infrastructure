{
  "Id": "key-consolepolicy-3",
  "Version": "2012-10-17",
  "Statement": [
      {
          "Sid": "Enable IAM User Permissions",
          "Effect": "Allow",
          "Principal": {
              "AWS": "arn:aws:iam::586831363346:root"
          },
          "Action": "kms:*",
          "Resource": "*"
      },
      {
          "Sid": "Allow access for Key Administrators",
          "Effect": "Allow",
          "Principal": {
              "AWS": [
                  "arn:aws:iam::586831363346:role/ExternalS3Role",
                  "arn:aws:iam::586831363346:role/ExternalAdminRole",
                  "arn:aws:iam::586831363346:user/ritesh",
                  "arn:aws:iam::586831363346:user/terraform-admin-dev"
              ]
          },
          "Action": [
              "kms:Create*",
              "kms:Describe*",
              "kms:Enable*",
              "kms:List*",
              "kms:Put*",
              "kms:Update*",
              "kms:Revoke*",
              "kms:Disable*",
              "kms:Get*",
              "kms:Delete*",
              "kms:TagResource",
              "kms:UntagResource",
              "kms:ScheduleKeyDeletion",
              "kms:CancelKeyDeletion"
          ],
          "Resource": "*"
      },
      {
          "Sid": "Allow use of the key",
          "Effect": "Allow",
          "Principal": {
              "AWS": [
                  "arn:aws:iam::586831363346:role/ExternalS3Role",
                  "arn:aws:iam::586831363346:role/ExternalAdminRole",
                  "arn:aws:iam::586831363346:role/ec2-instance",
                  "arn:aws:iam::586831363346:user/terraform-admin-dev",
                  "arn:aws:iam::586831363346:user/ritesh"
              ]
          },
          "Action": [
              "kms:Encrypt",
              "kms:Decrypt",
              "kms:ReEncrypt*",
              "kms:DescribeKey",
              "kms:GetPublicKey"
          ],
          "Resource": "*"
      },
      {
          "Sid": "Allow attachment of persistent resources",
          "Effect": "Allow",
          "Principal": {
              "AWS": [
                  "arn:aws:iam::586831363346:role/ExternalS3Role",
                  "arn:aws:iam::586831363346:role/ExternalAdminRole",
                  "arn:aws:iam::586831363346:role/ec2-instance",
                  "arn:aws:iam::586831363346:user/terraform-admin-dev",
                  "arn:aws:iam::586831363346:user/ritesh"
              ]
          },
          "Action": [
              "kms:CreateGrant",
              "kms:ListGrants",
              "kms:RevokeGrant"
          ],
          "Resource": "*",
          "Condition": {
              "Bool": {
                  "kms:GrantIsForAWSResource": "true"
              }
          }
      }
  ]
}